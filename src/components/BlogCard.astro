---
// src/components/BlogCard.astro
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  tags?: string[];
  slug: string;
  coverImage?: string;
}

const { title, description, date, category, tags = [], slug, coverImage } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

<a href={`/blog/${slug}`} class="group block bg-bg-subtle border border-border rounded-lg overflow-hidden hover:shadow-lg transition-all duration-200 flex flex-col h-full">
  <!-- Cover Image (Jika Ada) -->
  {coverImage && (
    <div class="aspect-video w-full overflow-hidden bg-border">
      <img 
        src={coverImage} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  )}

  <div class="p-6 flex flex-col flex-grow">
    <!-- Meta (Kategori & Tanggal) -->
    <div class="flex items-center gap-3 text-xs text-text-muted mb-3">
      <span class="bg-primary/10 text-primary px-2 py-1 rounded font-medium capitalize">
        {category.replace('-', ' ')}
      </span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-text group-hover:text-primary transition-colors mb-2 leading-snug">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-sm text-text-muted mb-4 line-clamp-3 flex-grow">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-border">
        {tags.map(tag => (
          <span class="text-xs text-text-muted bg-bg border border-border px-2 py-1 rounded-md">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>