---
// src/components/SkillBadge.astro
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium bg-bg border border-border text-text hover:border-primary hover:text-primary transition-colors cursor-default">
  {name}
</span>