---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-bg-subtle border-t border-border mt-auto">
  <div class="container-page py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Column 1: Brand -->
      <div class="md:col-span-1">
        <h2 class="text-xl font-bold text-text mb-2">Arkan Tsabit</h2>
        <p class="text-sm text-text-muted mb-4">
          Full Stack Developer & Cloud Data Engineer building scalable data pipelines and modern web applications.
        </p>
        <p class="text-sm text-text-muted">
          Oracle Top 108 Global
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="font-bold text-text mb-4">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-text-muted hover:text-primary transition-colors">Home</a></li>
          <li><a href="/about" class="text-text-muted hover:text-primary transition-colors">About</a></li>
          <li><a href="/skills" class="text-text-muted hover:text-primary transition-colors">Skills & Certs</a></li>
          <li><a href="/services" class="text-text-muted hover:text-primary transition-colors">Services</a></li>
          <li><a href="/katalog" class="text-text-muted hover:text-primary transition-colors">Katalog</a></li>
        </ul>
      </div>

      <!-- Column 3: Social -->
      <div>
        <h3 class="font-bold text-text mb-4">Social</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://github.com/ArkanTsabit123" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors flex items-center gap-2">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://linkedin.com/in/arkan-tsabit-0b12b9407" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-primary transition-colors flex items-center gap-2">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="mailto:arkantsabit025@gmail.com" class="text-text-muted hover:text-primary transition-colors flex items-center gap-2">
              Email
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Site Info -->
      <div>
        <h3 class="font-bold text-text mb-4">About This Site</h3>
        <p class="text-sm text-text-muted mb-2">
          Built with Astro 5, Tailwind CSS 4, and React.
        </p>
        <p class="text-sm text-text-muted">
          &copy; {currentYear} Arkan Tsabit. All rights reserved.
        </p>
        <p class="text-xs text-text-muted mt-4">
          Version 1.0.0
        </p>
      </div>

    </div>
  </div>
</footer>