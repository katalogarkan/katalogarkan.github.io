---
// src/components/Footer.astro
// 4-column footer: name+tagline, quick links, social, copyright.

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Katalog', href: '/katalog' },
  { label: 'Contact', href: '/contact' },
];

const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/katalogarkan',
    icon: 'github',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/katalogarkan',
    icon: 'linkedin',
  },
  {
    label: 'Email',
    href: 'mailto:hello@katalogarkan.github.io',
    icon: 'mail',
  },
];

const year = new Date().getFullYear();
const version = '0.2.0';
---

<footer class="bg-bg-subtle border-t border-border mt-16">
  <div class="container-page py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Column 1: Name + tagline -->
      <div>
        <h2 class="text-lg font-bold text-text mb-2">Arkan</h2>
        <p class="text-sm text-text-muted">
          Full Stack Web Developer building fast, accessible, and
          maintainable web experiences.
        </p>
      </div>

      <!-- Column 2: Quick links -->
      <div>
        <h3 class="text-sm font-bold text-text uppercase tracking-wide mb-3">
          Quick Links
        </h3>
        <ul class="space-y-2">
          {quickLinks.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-sm text-text-muted hover:text-primary transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Social -->
      <div>
        <h3 class="text-sm font-bold text-text uppercase tracking-wide mb-3">
          Social
        </h3>
        <ul class="space-y-2">
          {socialLinks.map(({ label, href, icon }) => (
            <li>
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-primary transition-colors"
              >
                {icon === 'github' && (
                  <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                  </svg>
                )}
                {icon === 'linkedin' && (
                  <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
                  </svg>
                )}
                {icon === 'mail' && (
                  <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Copyright + version -->
      <div>
        <h3 class="text-sm font-bold text-text uppercase tracking-wide mb-3">
          About This Site
        </h3>
        <p class="text-sm text-text-muted">
          Built with Astro 5, Tailwind CSS 4, and React.
        </p>
        <p class="text-sm text-text-muted mt-2">
          © {year} Arkan. All rights reserved.
        </p>
        <p class="text-xs text-text-muted mt-2">
          Version {version}
        </p>
      </div>

    </div>
  </div>
</footer>