---
// src/components/Header.astro
// Sticky header with 9 nav links + hamburger menu for mobile.
// Hamburger toggle via vanilla JS <script> below.

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Skills', href: '/skills' },
  { label: 'Katalog', href: '/katalog' },
  { label: 'Services', href: '/services' },
  { label: 'Blog', href: '/blog' },
  { label: 'Resources', href: '/resources' },
  { label: 'Testimonials', href: '/testimonials' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-bg border-b border-border shadow-sm">
  <div class="container-page">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a
        href="/"
        class="text-xl font-bold text-text hover:text-primary transition-colors"
        aria-label="Arkan — Home"
      >
        Arkan
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(({ label, href }) => (
          <a
            href={href}
            class:list={[
              'px-3 py-2 rounded-md text-sm font-medium transition-colors',
              currentPath === href
                ? 'text-primary bg-primary/10'
                : 'text-text-muted hover:text-text hover:bg-bg-subtle',
            ]}
            aria-current={currentPath === href ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-md
               text-text-muted hover:text-text hover:bg-bg-subtle
               focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2
               transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Hamburger icon (open) -->
        <svg
          id="menu-icon-open"
          class="w-6 h-6"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close icon (hidden initially) -->
        <svg
          id="menu-icon-close"
          class="w-6 h-6 hidden"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-4 border-t border-border"
      aria-label="Mobile navigation"
    >
      <ul class="flex flex-col gap-1 pt-2">
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={[
                'block px-3 py-2 rounded-md text-base font-medium transition-colors',
                currentPath === href
                  ? 'text-primary bg-primary/10'
                  : 'text-text-muted hover:text-text hover:bg-bg-subtle',
              ]}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Hamburger toggle — vanilla JS, no framework needed.
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function setExpanded(expanded: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.setAttribute('aria-label', expanded ? 'Close menu' : 'Open menu');
    menu.classList.toggle('hidden', !expanded);
    iconOpen?.classList.toggle('hidden', expanded);
    iconClose?.classList.toggle('hidden', !expanded);
  }

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    setExpanded(!expanded);
  });

  // Close menu on navigation (optional, improves UX)
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setExpanded(false));
  });
</script>