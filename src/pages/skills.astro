---

<BaseLayout {title} {description}>
  <section class="py-12 md:py-16">
    <div class="container-page max-w-5xl">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl font-bold text-text mb-4">Skills & Certifications</h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Technologies I use to build scalable data pipelines and web applications, backed by 10 professional certifications.
        </p>
      </div>

      <!-- 1. TECHNICAL SKILLS -->
      <div class="mb-20">
        <h2 class="text-2xl font-bold text-text mb-8 border-b border-border pb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
          Technical Expertise
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {categories.map((category) => (
            <div class="bg-bg-subtle border border-border rounded-lg p-6">
              <h3 class="text-lg font-bold text-text mb-4 flex items-center gap-3 border-b border-border pb-3">
                {category.icon === 'database' && (
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                )}
                {category.icon === 'cloud' && (
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
                )}
                {category.icon === 'server' && (
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>
                )}
                {category.icon === 'code' && (
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                )}
                {category.icon === 'chart' && (
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
                )}
                {category.name}
              </h3>
              <div class="flex flex-wrap gap-2">
                {category.skills.map((skill) => (
                  <SkillBadge name={skill} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 2. CERTIFICATIONS -->
      <div>
        <h2 class="text-2xl font-bold text-text mb-8 border-b border-border pb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Verified Certifications
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {certifications.map((cert) => (
            <div class="bg-bg-subtle border border-border rounded-lg p-5 flex flex-col justify-between hover:shadow-md transition-shadow">
              <div>
                <div class="flex justify-between items-start mb-2">
                  <span class="text-xs font-bold text-primary bg-primary/10 px-2 py-1 rounded">{cert.issuer}</span>
                  <span class="text-xs text-text-muted font-medium">{cert.date}</span>
                </div>
                <h3 class="font-bold text-text text-sm leading-snug mb-1">{cert.name}</h3>
                <p class="text-xs text-text-muted mb-4">{cert.level} Level</p>
              </div>
              
              <a href={cert.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-sm font-medium text-primary hover:text-primary-hover transition-colors mt-2">
                Verify Credential
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>