---
// src/pages/testimonials.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Testimonials — Arkan Tsabit';
const description = 'Read reviews from clients or leave your own testimonial.';
---

<BaseLayout {title} {description}>
  <section class="py-12 md:py-16">
    <div class="container-page max-w-5xl">
      
      <!-- Header -->
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <h1 class="text-4xl font-bold text-text mb-4">Client Testimonials</h1>
        <p class="text-lg text-text-muted">
          Read what others have said about my work, or share your own experience.
        </p>
      </div>

      <!-- 1. FORM TESTIMONI -->
      <div class="max-w-2xl mx-auto bg-bg-subtle border border-border rounded-lg p-8 mb-20 shadow-sm">
        <div class="text-center mb-6">
          <h2 class="text-2xl font-bold text-text mb-2">Leave a Testimonial</h2>
          <p class="text-sm text-text-muted">Worked with me before? I'd love to hear your feedback!</p>
        </div>

        <form id="testimonial-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="t-name" class="block text-sm font-medium text-text mb-1">Your Name</label>
              <input type="text" id="t-name" name="Name" required class="w-full px-4 py-2 rounded-md border border-border bg-bg text-text focus:ring-2 focus:ring-primary" placeholder="Your full name" />
            </div>
            <div>
              <label for="t-role" class="block text-sm font-medium text-text mb-1">Your Role / Company</label>
              <input type="text" id="t-role" name="Role" required class="w-full px-4 py-2 rounded-md border border-border bg-bg text-text focus:ring-2 focus:ring-primary" placeholder="Your Role at your company" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="t-email" class="block text-sm font-medium text-text mb-1">Email (Not Public)</label>
              <input type="email" id="t-email" name="Email" required class="w-full px-4 py-2 rounded-md border border-border bg-bg text-text focus:ring-2 focus:ring-primary" placeholder="your.email@example.com" />
            </div>
            <div>
              <label for="t-rating" class="block text-sm font-medium text-text mb-1">Satisfaction Rating</label>
              <select id="t-rating" name="Rating" required class="w-full px-4 py-2 rounded-md border border-border bg-bg text-text focus:ring-2 focus:ring-primary appearance-none">
                <option value="5">⭐⭐⭐⭐⭐ (Excellent)</option>
                <option value="4">⭐⭐⭐⭐ (Very Good)</option>
                <option value="3">⭐⭐⭐ (Good)</option>
                <option value="2">⭐⭐ (Fair)</option>
                <option value="1">⭐ (Poor)</option>
              </select>
            </div>
          </div>

          <div>
            <label for="t-message" class="block text-sm font-medium text-text mb-1">Your Review</label>
            <textarea id="t-message" name="Message" rows="4" required class="w-full px-4 py-2 rounded-md border border-border bg-bg text-text focus:ring-2 focus:ring-primary" placeholder="Tell us about your experience working with Arkan..."></textarea>
          </div>
          <button type="submit" id="t-submit-btn" class="w-full px-6 py-3 rounded-md bg-primary text-white font-medium hover:bg-primary-hover transition-colors">
            Submit Testimonial
          </button>
          <p id="t-status" class="text-sm text-center mt-4 hidden"></p>
        </form>
      </div>

      <!-- 2. LIST TESTIMONI (Live dari Google Sheets) -->
      <div>
        <h2 class="text-2xl font-bold text-text mb-8 text-center border-t border-border pt-12">What Clients Say</h2>
        
        <div id="testimonial-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="col-span-full text-center py-10 text-text-muted">Loading testimonials...</div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script is:inline>
  // URL BARU YANG SUDAH ANDA DEPLOY
  const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwnQIs-kyBT8DToIlr50FrZKYVf04GwqxmhuE8a70yfRv4LZtVxeV_p_zvYpsMLCHjc/exec';

  const listContainer = document.getElementById('testimonial-list');
  const form = document.getElementById('testimonial-form');
  const submitBtn = document.getElementById('t-submit-btn');
  const statusDiv = document.getElementById('t-status');

  // Fungsi membuat bintang
  function getStars(rating) {
    let stars = '';
    for (let i = 1; i <= 5; i++) {
      if (i <= parseInt(rating || 5)) {
        stars += '<span class="text-warning text-lg">★</span>';
      } else {
        stars += '<span class="text-border text-lg">★</span>';
      }
    }
    return `<div class="flex mb-3">${stars}</div>`;
  }

  // Fungsi format tanggal (Tanggal + Jam)
  function formatDate(dateString) {
    if (!dateString) return '';
    
    const date = new Date(dateString);
    if (isNaN(date.getTime())) return dateString; 

    // Format: Nov 6, 2026, 01:33 AM
    return date.toLocaleDateString('en-US', { 
      month: 'short', 
      day: 'numeric', 
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true
    });
  }

  // 1. FUNGSI MENAMPILKAN TESTIMONI (GET)
  async function fetchTestimonials() {
    try {
      const response = await fetch(SCRIPT_URL);
      const data = await response.json();

      // PERBAIKAN: Filter mendeteksi 'Name' (huruf besar) atau 'name' (huruf kecil)
      const validData = data.filter(t => (t.Name || t.name) && (t.Name || t.name).trim() !== '');

      if (validData.length === 0) {
        listContainer.innerHTML = '<div class="col-span-full text-center py-10 text-text-muted">No testimonials yet. Be the first to leave one!</div>';
        return;
      }

      // Render kartu testimoni
      listContainer.innerHTML = validData.map(t => {
        // Deteksi nama kolom (huruf besar atau kecil)
        const name = t.Name || t.name || 'Anonymous';
        const role = t.Role || t.role || 'Client';
        const rating = t.Rating || t.rating || 5;
        const message = t.Message || t.message || '';
        const dateValue = t.Date || t.date || '';
        
        return `
        <blockquote class="bg-bg-subtle border border-border rounded-lg p-6 flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            ${getStars(rating)}
            <p class="text-text mb-6 italic">"${message}"</p>
          </div>
          <footer class="flex items-center justify-between border-t border-border pt-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-primary/10 text-primary rounded-full flex items-center justify-center font-bold">
                ${name.charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="font-bold text-text text-sm">${name}</p>
                <p class="text-xs text-text-muted">${role}</p>
              </div>
            </div>
            <!-- Tampilkan Tanggal + Jam -->
            ${dateValue ? `<div class="text-xs text-text-muted font-medium text-right">${formatDate(dateValue)}</div>` : ''}
          </footer>
        </blockquote>
      `}).join('');
    } catch (error) {
      listContainer.innerHTML = '<div class="col-span-full text-center py-10 text-danger">Failed to load testimonials.</div>';
    }
  }

  // Panggil fungsi saat halaman dimuat
  fetchTestimonials();

  // 2. FUNGSI MENGIRIM TESTIMONI (POST)
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Submitting...';
    statusDiv.classList.add('hidden');

    const formData = new FormData(form);
    formData.append('formType', 'testimonial'); 

    try {
      const response = await fetch(SCRIPT_URL, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        statusDiv.textContent = 'Thank you! Your testimonial has been submitted.';
        statusDiv.className = 'text-sm text-center mt-4 text-success font-medium block';
        form.reset();
        
        // Refresh daftar testimoni setelah 2 detik
        setTimeout(fetchTestimonials, 2000); 
      } else {
        throw new Error('Network error');
      }
    } catch (error) {
      statusDiv.textContent = 'Oops! Something went wrong.';
      statusDiv.className = 'text-sm text-center mt-4 text-danger font-medium block';
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Submit Testimonial';
    }
  });
</script>