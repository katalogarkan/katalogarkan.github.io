---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '404 — Page Not Found';
const description = 'The page you are looking for does not exist.';
---

<BaseLayout {title} {description}>
  <section class="py-24 md:py-32 flex flex-col items-center justify-center text-center">
    <div class="container-page max-w-2xl">
      <h1 class="text-6xl md:text-8xl font-bold text-primary mb-6">404</h1>
      <h2 class="text-2xl md:text-3xl font-bold text-text mb-4">Page not found</h2>
      <p class="text-lg text-text-muted mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center px-6 py-3 rounded-md
               bg-primary text-white font-medium
               hover:bg-primary-hover
               focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2
               transition-colors"
      >
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>