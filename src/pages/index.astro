---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillBadge from '../components/SkillBadge.astro';
import { getCollection } from 'astro:content';

// Fetch featured projects (max 3)
const allProjects = await getCollection('katalog');
const featuredProjects = allProjects
  .filter((p) => p.data.featured === true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const topSkills = [
  'Python', 'SQL', 'Apache Airflow', 'BigQuery', 'Astro', 'React', 'Docker', 'Terraform'
];

const process = [
  {
    step: '01',
    title: 'Discovery',
    desc: 'A 30-minute call to understand your goals, constraints, and timeline. No commitment required.',
  },
  {
    step: '02',
    title: 'Proposal',
    desc: 'A written proposal with scope, deliverables, timeline, and fixed price. You approve before we start.',
  },
  {
    step: '03',
    title: 'Build',
    desc: 'Weekly progress updates, staging previews, and a shared task board. You see the work as it happens.',
  },
  {
    step: '04',
    title: 'Handoff',
    desc: 'Documentation, credentials, and a 30-day bug-fix warranty. Optional maintenance retainer available.',
  },
];

const faqs = [
  {
    q: 'How does the testimonial discount work?',
    a: 'If you agree to leave an honest testimonial after the project is delivered, you get 10% off the quoted price. The discount is applied to the final invoice — no strings attached, and you can still leave an honest review.',
  },
  {
    q: 'How do payments work?',
    a: '50% upfront to reserve the slot, 50% on delivery. For projects above $2,000, we can split into three milestones (30/40/30).',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'For international clients, I accept Wise (preferred — low fees, mid-market rate), PayPal, or direct bank transfer (SWIFT) for larger amounts. For Indonesian clients, I accept bank transfer or QRIS. Payment details are included on every invoice.',
  },
  {
    q: 'Who will actually work on my project?',
    a: 'I do. You work directly with me from discovery to handoff — no account managers, no outsourced teams. That means faster decisions and a single point of contact.',
  },
  {
    q: 'Do I own the code and files after delivery?',
    a: 'Yes. On final payment, you own the full source code, design files, and credentials. I retain the right to show the work in my portfolio unless we agree otherwise.',
  },
  {
    q: 'Do you offer a warranty?',
    a: 'Yes. Every project includes a 30-day bug-fix warranty after handoff. Bugs are fixed for free; new features are quoted separately.',
  },
];

const title = 'Arkan Tsabit — Full Stack & Data Engineer';
const description =
  'I help businesses build high-performance websites and scalable data pipelines. Oracle Top 108 Global. Available for freelance projects.';
---

<BaseLayout {title} {description}>

  <!-- ============================================ -->
  <!-- HERO SECTION -->
  <!-- ============================================ -->
  <section class="py-20 md:py-32 relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-bg to-bg"></div>

    <div class="container-page max-w-4xl text-center">
      <p class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6">
        Available for Freelance Projects
      </p>
      <h1 class="text-4xl md:text-6xl font-bold text-text leading-tight mb-6">
        I build <span class="text-primary">Data Pipelines</span> & <span class="text-primary">Modern Websites</span>.
      </h1>
      <p class="text-lg md:text-xl text-text-muted mb-6 max-w-2xl mx-auto">
        Hi, I'm Arkan Tsabit. I am a Full Stack Developer and Cloud Data Engineer with 10+ professional certifications (Oracle, IBM, Meta). I help businesses turn raw data into automated, production-ready applications.
      </p>
      <p class="text-base text-text-muted mb-10 max-w-2xl mx-auto">
        I'm currently opening my freelance practice — which means you get senior-level work at introductory rates, in exchange for an honest testimonial after delivery.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/services" class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-primary text-white font-medium text-lg hover:bg-primary-hover focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition-colors shadow-lg shadow-primary/20">
          View My Services
        </a>
        <a href="/katalog" class="inline-flex items-center justify-center px-8 py-4 rounded-md bg-bg-subtle text-text font-medium text-lg border border-border hover:bg-border hover:text-text focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 transition-colors">
          See My Projects
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- STATS / SOCIAL PROOF -->
  <!-- ============================================ -->
  <section class="py-10 border-y border-border bg-bg-subtle">
    <div class="container-page max-w-5xl">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-3xl md:text-4xl font-bold text-primary mb-1">10+</p>
          <p class="text-sm font-medium text-text-muted">Certifications</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-bold text-primary mb-1">Top 108</p>
          <p class="text-sm font-medium text-text-muted">Oracle Global Rank</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-bold text-primary mb-1">2.96M+</p>
          <p class="text-sm font-medium text-text-muted">Rows Processed</p>
          <p class="text-xs text-text-muted/70 mt-0.5">BatchETL · NYC Taxi</p>
        </div>
        <div>
          <p class="text-3xl md:text-4xl font-bold text-primary mb-1">100%</p>
          <p class="text-sm font-medium text-text-muted">Data Quality</p>
          <p class="text-xs text-text-muted/70 mt-0.5">BatchETL pipeline</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SERVICES SUMMARY -->
  <!-- ============================================ -->
  <section class="py-16 md:py-24">
    <div class="container-page max-w-5xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-text mb-4">What I Can Do For You</h2>
        <p class="text-text-muted max-w-2xl mx-auto">
          From designing high-performance websites to architecting scalable cloud data pipelines.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Web Dev -->
        <div class="bg-bg-subtle border border-border rounded-lg p-8 hover:border-primary transition-colors">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-text mb-3">Web Development</h3>
          <p class="text-sm text-text-muted mb-6">Modern, fast, and SEO-optimized websites built with Astro, React, and Tailwind CSS.</p>
          <a href="/services#web-dev" class="text-sm font-medium text-primary hover:text-primary-hover">Learn more →</a>
        </div>

        <!-- Data Eng -->
        <div class="bg-bg-subtle border border-border rounded-lg p-8 hover:border-primary transition-colors">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-text mb-3">Data Engineering</h3>
          <p class="text-sm text-text-muted mb-6">Automated ETL pipelines and data warehouses using Python, Airflow, and BigQuery.</p>
          <a href="/services#data-eng" class="text-sm font-medium text-primary hover:text-primary-hover">Learn more →</a>
        </div>

        <!-- Cloud -->
        <div class="bg-bg-subtle border border-border rounded-lg p-8 hover:border-primary transition-colors">
          <div class="w-12 h-12 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-text mb-3">Cloud & DevOps</h3>
          <p class="text-sm text-text-muted mb-6">Infrastructure as Code, Docker containerization, and CI/CD pipelines.</p>
          <a href="/services#cloud-devops" class="text-sm font-medium text-primary hover:text-primary-hover">Learn more →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- HOW IT WORKS -->
  <!-- ============================================ -->
  <section class="py-16 md:py-24 border-t border-border bg-bg-subtle/50">
    <div class="container-page max-w-5xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-text mb-4">How It Works</h2>
        <p class="text-text-muted max-w-2xl mx-auto">
          A simple, transparent process — from first call to final handoff.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {process.map((item) => (
          <div class="bg-bg border border-border rounded-lg p-6">
            <span class="text-4xl font-bold text-primary/30">{item.step}</span>
            <h3 class="font-bold text-text mt-2 mb-2">{item.title}</h3>
            <p class="text-sm text-text-muted leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- FEATURED PROJECTS -->
  <!-- ============================================ -->
  {featuredProjects.length > 0 && (
    <section class="py-16 md:py-24 border-t border-border">
      <div class="container-page max-w-5xl">
        <div class="flex items-end justify-between mb-8">
          <div>
            <h2 class="text-3xl font-bold text-text">Featured Projects</h2>
            <p class="text-text-muted mt-2">Real-world solutions I've built.</p>
          </div>
          <a href="/katalog" class="hidden sm:inline-flex text-sm font-medium text-primary hover:text-primary-hover">
            View all projects →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredProjects.map((project) => (
            <a href={`/katalog/${project.id}`} class="group block bg-bg-subtle border border-border rounded-lg p-6 shadow-sm hover:shadow-md transition-all">
              <h3 class="text-lg font-bold text-text group-hover:text-primary transition-colors mb-2">
                {project.data.title}
              </h3>
              <p class="text-sm text-text-muted mb-4 line-clamp-3">
                {project.data.description}
              </p>
              <div class="flex flex-wrap gap-1">
                {project.data.techStack.slice(0, 3).map((tech) => (
                  <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-primary/10 text-primary">
                    {tech}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============================================ -->
  <!-- SKILLS SUMMARY -->
  <!-- ============================================ -->
  <section class="py-16 border-t border-border">
    <div class="container-page max-w-5xl text-center">
      <h2 class="text-2xl font-bold text-text mb-6">Core Technologies</h2>
      <div class="flex flex-wrap justify-center gap-2 max-w-3xl mx-auto">
        {topSkills.map((skill) => (
          <SkillBadge name={skill} />
        ))}
      </div>
      <div class="mt-8">
        <a href="/skills" class="text-sm font-medium text-primary hover:text-primary-hover">View all skills & certifications →</a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- FAQ -->
  <!-- ============================================ -->
  <section class="py-16 md:py-24 border-t border-border bg-bg-subtle/50">
    <div class="container-page max-w-3xl">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-text mb-4">Frequently Asked Questions</h2>
        <p class="text-text-muted max-w-2xl mx-auto">
          Everything you need to know before we start.
        </p>
      </div>
      <div class="space-y-4">
        {faqs.map((item) => (
          <details class="group bg-bg border border-border rounded-lg p-6">
            <summary class="cursor-pointer font-semibold text-text list-none flex justify-between items-center gap-4">
              <span>{item.q}</span>
              <svg
                class="w-5 h-5 text-text-muted shrink-0 group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <p class="mt-4 text-sm text-text-muted leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/services" class="text-sm font-medium text-primary hover:text-primary-hover">
          View Pricing →
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- FINAL CTA -->
  <!-- ============================================ -->
  <section class="py-16 md:py-24 border-t border-border">
    <div class="container-page max-w-4xl">
      <div class="bg-primary text-white rounded-2xl p-8 md:p-12 text-center shadow-xl shadow-primary/20 relative overflow-hidden">
        <div class="absolute top-0 right-0 -mr-8 -mt-8 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>

        <h2 class="text-3xl md:text-4xl font-bold mb-4 relative z-10">
          Ready to build something great?
        </h2>
        <p class="text-white/90 text-lg mb-8 max-w-xl mx-auto relative z-10">
          Let's discuss your project. Whether you need a high-performance website or an automated data pipeline, I can help you achieve it.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4 relative z-10">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-3 rounded-md bg-white text-primary font-bold hover:bg-gray-100 transition-colors">
            Book a Free Discovery Call
          </a>
          <a href="/services" class="inline-flex items-center justify-center px-8 py-3 rounded-md bg-white/10 text-white font-medium border border-white/30 hover:bg-white/20 transition-colors">
            View Pricing
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>