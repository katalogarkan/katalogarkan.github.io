---
// src/layouts/PostLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  tags?: string[];
  backUrl: string;
  backLabel: string;
}

const { title, description, date, category, tags = [], backUrl, backLabel } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});
---

<BaseLayout {title} {description}>
  <article class="py-12 md:py-16">
    <div class="container-page max-w-3xl">
      
      <!-- Back Link -->
      <a href={backUrl} class="inline-flex items-center gap-2 text-sm font-medium text-text-muted hover:text-primary transition-colors mb-8">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Back to {backLabel}
      </a>

      <!-- Header -->
      <header class="mb-8 border-b border-border pb-8">
        <div class="flex items-center gap-3 text-sm text-text-muted mb-4">
          <span class="bg-primary/10 text-primary px-2 py-1 rounded-md font-medium capitalize">{category.replace('-', ' ')}</span>
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold text-text mb-4 leading-tight">{title}</h1>
        <p class="text-lg text-text-muted">{description}</p>
        
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {tags.map(tag => (
              <span class="text-sm text-text-muted bg-bg-subtle border border-border px-3 py-1 rounded-full">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Body -->
      <div class="prose dark:prose-invert max-w-none text-text">
        <slot />
      </div>
      
    </div>
  </article>
</BaseLayout>